<view class="page">
  <camera
    class="camera"
    device-position="back"
    flash="off"
    frame-size="small"
    style="position:absolute;left:0;top:0;width:100vw;height:100vh;"
    wx:if="{{step !== 'blow' && step !== 'done'}}"
  ></camera>

  <view class="candle-bg" wx:if="{{step === 'blow' || step === 'done'}}">
    <image class="candle-image" src="/assets/images/candle.png" mode="aspectFit" />
  </view>

  <canvas
    canvas-id="overlay"
    class="overlay"
    style="width:100vw;height:100vh;"
    width="{{canvasWidth}}"
    height="{{canvasHeight}}"
  />

  <canvas
    canvas-id="roiPreviewCanvas"
    class="roi-preview-canvas"
    style="width:{{roiPreviewWidth}}px;height:{{roiPreviewHeight}}px;position:absolute;left:-9999px;top:-9999px;opacity:0;"
    width="{{roiPreviewWidth}}"
    height="{{roiPreviewHeight}}"
  />

  <view class="top-bar">
    <view class="top-back" bindtap="goHome">返回</view>
    <view class="top-title">XR互动</view>
    <view class="top-actions" wx:if="{{step === 'scan'}}">
      <view class="top-btn detect" bindtap="toggleDetect">{{detectEnabled ? '停止识别' : '开始识别'}}</view>
      <view class="top-btn" bindtap="toggleTuner">参数调试</view>
      <view class="top-btn" bindtap="toggleDebugRoiBinary">{{debugRoiBinary ? '灰度预览' : '黑白预览'}}</view>
      <view class="top-btn sample" bindtap="toggleSampleCollect">{{sampleCollecting ? ('采集中 ' + sampleCollectCount + '/' + sampleCollectTarget) : '开始采集'}}</view>
      <view class="top-btn export" bindtap="exportSampleJson">导出采样JSON</view>
    </view>
  </view>

  <view class="status-text {{scanState === 'cooldown' ? 'cooldown' : ''}}" wx:if="{{step === 'scan'}}">{{scanPattern}}</view>
  <view class="status-hint" wx:if="{{step === 'scan' && scanHint}}">{{scanHint}}</view>
  <view class="status-success" wx:if="{{step === 'scan' && scanState === 'matched'}}">识别成功</view>

  <view class="scan-frame {{scanState}}" wx:if="{{step === 'scan' && scanState !== 'completed'}}"></view>

  <view class="progress" wx:if="{{step === 'scan'}}">
    <text>{{collected.length}} / 13 已收集</text>
    <progress percent="{{percent}}" active stroke-width="6" activeColor="#FF7A23" />
  </view>


  <cover-view class="sample-progress" wx:if="{{step === 'scan' && sampleCollecting}}">
    <cover-view class="sample-progress-inner">采集进度：{{sampleCollectCount}} / {{sampleCollectTarget}}</cover-view>
  </cover-view>
  <view class="tuner-panel" wx:if="{{step === 'scan' && showTuner}}">
    <scroll-view class="tuner-scroll" scroll-y>
      <view class="tuner-title">识别参数调试</view>
      <view class="preset-row">
        <view class="preset-btn" data-preset="strict" bindtap="applyTunerPreset">严格</view>
        <view class="preset-btn" data-preset="balanced" bindtap="applyTunerPreset">平衡</view>
        <view class="preset-btn" data-preset="loose" bindtap="applyTunerPreset">宽松</view>
      </view>
      <view class="tuner-item">
        <view>单帧阈值(frameMinConf)</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="frameMinConf" data-delta="-0.02" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.frameMinConf}}</view>
          <view class="step-btn" data-key="frameMinConf" data-delta="0.02" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>稳定阈值(stableMinAvgConf)</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="stableMinAvgConf" data-delta="-0.02" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.stableMinAvgConf}}</view>
          <view class="step-btn" data-key="stableMinAvgConf" data-delta="0.02" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>请求间隔(ms)</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="requestInterval" data-delta="-10" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.requestInterval}}</view>
          <view class="step-btn" data-key="requestInterval" data-delta="10" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>弱网间隔(ms)</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="requestIntervalWeak" data-delta="-20" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.requestIntervalWeak}}</view>
          <view class="step-btn" data-key="requestIntervalWeak" data-delta="20" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>Canny Low</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="cannyLow" data-delta="-5" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.cannyLow}}</view>
          <view class="step-btn" data-key="cannyLow" data-delta="5" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>Canny High</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="cannyHigh" data-delta="-10" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.cannyHigh}}</view>
          <view class="step-btn" data-key="cannyHigh" data-delta="10" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>空白阈值(edgeRatio)</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="edgeRatioEmpty" data-delta="-0.002" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.edgeRatioEmpty}}</view>
          <view class="step-btn" data-key="edgeRatioEmpty" data-delta="0.002" bindtap="adjustTuner">+</view>
        </view>
      </view>
      <view class="tuner-item">
        <view>模板阈值(match)</view>
        <view class="tuner-stepper">
          <view class="step-btn" data-key="matchThreshold" data-delta="-0.02" bindtap="adjustTuner">-</view>
          <view class="step-value">{{tuner.matchThreshold}}</view>
          <view class="step-btn" data-key="matchThreshold" data-delta="0.02" bindtap="adjustTuner">+</view>
        </view>
      </view>

      <view class="tuner-title">识别统计</view>
      <view class="tuner-item"><view>总帧</view><view>{{tunerStats.total || 0}}</view></view>
      <view class="tuner-item"><view>circle</view><view>{{tunerStats.circle || 0}}</view></view>
      <view class="tuner-item"><view>cross</view><view>{{tunerStats.cross || 0}}</view></view>
      <view class="tuner-item"><view>empty</view><view>{{tunerStats.empty || 0}}</view></view>
      <view class="tuner-item"><view>unknown</view><view>{{tunerStats.unknown || 0}}</view></view>
      <view class="tuner-item"><view>平均耗时(ms)</view><view>{{tunerStats.avgLatency ? tunerStats.avgLatency.toFixed(0) : 0}}</view></view>
      <view class="tuner-item">
        <view>Debug</view>
        <view class="debug-text">{{lastDebugText}}</view>
      </view>
      <view class="tuner-title">识别框详情</view>
      <view class="tuner-table" wx:if="{{scanItemsTable && scanItemsTable.length}}">
        <view class="tuner-table-header">
          <text class="col col-idx">#</text>
          <text class="col col-label">类型</text>
          <text class="col col-x">X</text>
          <text class="col col-y">Y</text>
          <text class="col col-w">W</text>
          <text class="col col-h">H</text>
        </view>
        <view class="tuner-table-row" wx:for="{{scanItemsTable}}" wx:key="idx">
          <text class="col col-idx">{{item.idx}}</text>
          <text class="col col-label">{{item.label}}</text>
          <text class="col col-x">{{item.x === null ? '-' : item.x}}</text>
          <text class="col col-y">{{item.y === null ? '-' : item.y}}</text>
          <text class="col col-w">{{item.w === null ? '-' : item.w}}</text>
          <text class="col col-h">{{item.h === null ? '-' : item.h}}</text>
        </view>
      </view>
      <view class="tuner-item">
        <view>识别框详情</view>
        <view class="debug-text">{{scanItemsPreview}}</view>
      </view>
      <view class="roi-preview-grid" wx:if="{{debugImageEdge || debugImageThreshold || debugImageInput}}">
        <view class="roi-preview-cell" wx:if="{{debugImageInput}}">
          <view class="roi-preview-title">ROI Input</view>
          <image class="roi-preview-image" src="{{debugImageInput}}" mode="aspectFit" />
        </view>
        <view class="roi-preview-cell" wx:if="{{debugImageEdge}}">
          <view class="roi-preview-title">Edge</view>
          <image class="roi-preview-image" src="{{debugImageEdge}}" mode="aspectFit" />
        </view>
        <view class="roi-preview-cell" wx:if="{{debugImageThreshold}}">
          <view class="roi-preview-title">Threshold</view>
          <image class="roi-preview-image" src="{{debugImageThreshold}}" mode="aspectFit" />
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="winder-stage" wx:if="{{step === 'winder'}}" bindtouchstart="onWinderRotateStart" bindtouchmove="onWinderRotateMove" bindtouchend="onWinderRotateEnd">
    <view class="winder-frame"></view>
    <view class="winder-arrow" wx:if="{{winderStatus !== 'scan'}}"></view>
    <view class="winder-progress" wx:if="{{winderStatus === 'rotating' || winderStatus === 'completed'}}">
      <view class="winder-progress-inner" style="transform:rotate({{rotateDegree}}deg);"></view>
    </view>
    <view class="winder-text">{{winderHint}}</view>
    <view class="guide-card" wx:if="{{showGuideCard}}">8秒未对齐，试试将发条放在框内并保持稳定</view>
  </view>

  <view class="blow-stage" wx:if="{{step === 'blow' || step === 'done'}}">
    <view class="blow-tip">{{blowHint}}</view>
    <view class="blow-wave" wx:if="{{blowState === 'listening'}}"></view>
  </view>

  <view class="achievement" wx:if="{{showAchievement}}">
    <view class="achievement-card">
      <view class="achievement-title">恭喜解锁成就</view>
      <view class="achievement-sub">生日快乐</view>
      <view class="achievement-actions">
        <view class="btn primary" bindtap="goHome">返回主页</view>
      </view>
    </view>
  </view>
</view>
