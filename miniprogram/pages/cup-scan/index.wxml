<view class="container">
  <camera mode="normal" device-position="back" flash="off" binderror="error" frame-size="large">
    <view class="scan-mask">
      <view class="recognition-frame"></view>
      <view class="tip-box">
        <text class="main-tip">对准杯子进行识别</text>
        <text class="sub-tip">识别成功后将自动为您解锁卡牌</text>
      </view>
      
      <!-- Placeholder for recognition animation or status -->
      <view class="recognition-status" wx:if="{{recognizing}}">
        <view class="loading-spinner"></view>
        <text>正在匹配中...</text>
      </view>

      <view class="footer">
        <button class="back-btn" bindtap="goBack">返回</button>
      </view>
    </view>
  </camera>
</view>