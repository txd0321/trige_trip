<view class="container">
  <view class="loading-state" wx:if="{{loading}}">
    <text class="tip">加载中...</text>
  </view>

  <view class="error-state" wx:elif="{{error}}">
    <text class="tip">{{error}}</text>
  </view>

  <view class="card-detail" wx:else>
    <view class="card-image-box {{unlocked ? '' : 'locked'}}">
      <image class="cover" src="{{card.cover}}" mode="aspectFit"></image>
      <view class="lock-overlay" wx:if="{{!unlocked}}">
        <view class="lock-icon"></view>
      </view>
    </view>

    <view class="info-section">
      <text class="name">{{card.name}}</text>
      <text class="desc" wx:if="{{card.desc}}">{{card.desc}}</text>
    </view>

    <view class="action-section">
      <block wx:if="{{unlocked}}">
        <view class="status-tag success">已解锁</view>
        <button class="primary-btn secondary" bindtap="goBack">返回个人中心</button>
      </block>
      <block wx:else>
        <view class="status-tag pending">待解锁</view>
        <button class="primary-btn" bindtap="onUnlock">开启旅程</button>
      </block>
    </view>
  </view>
</view>
