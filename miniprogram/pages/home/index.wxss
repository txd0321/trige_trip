/* pages/home/index.wxss */
.container {
  position: fixed;   /* 彻底贴满视口 */
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background: #000;
}

.placeholder-img,
.elf-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ar-btn {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  background-color: #FF7A23;
  color: #fff;
  border-radius: 12rpx;
  z-index: 10;
}

.top-bar {
  position: fixed;
  top: env(safe-area-inset-top);
  left: 0;
  width: 100%;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 9;
}
