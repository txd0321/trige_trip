<!-- pages/home/index.wxml -->
<view class="container" bindtap="handleTap">
  <!-- 占位图 / 空状态插画 -->
  <image
    class="placeholder-img"
    src="{{showEmptyState ? emptyIllustration : placeholderSrc}}"
    mode="aspectFill"
    wx:if="{{showPlaceholder || showEmptyState}}"
  />

  <!-- 全屏视频精灵 -->
  <video
    id="elfVideo"
    class="elf-video"
    src="{{currentSrc}}"
    autoplay
    loop="{{isLoop}}"
    controls="false"
    show-center-play-btn="false"
    object-fit="cover"
    bindloadedmetadata="onVideoLoaded"
    bindplay="onVideoPlay" bindended="onVideoEnded"
  />

  <!-- 顶部栏 -->
  <view class="top-bar">
    <image class="logo" src="../../images/logo.png" mode="heightFix" />
    <switch class="music-switch" checked="{{musicOn}}" bindchange="toggleMusic" />
  </view>

  <!-- AR 探索主按钮 -->
  <button class="ar-btn" type="primary" catchtap="goAR">AR 探索</button>
</view>
