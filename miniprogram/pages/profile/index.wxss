page {
  background-color: #F3FAFC;
  height: 100%;
}

.container {
  padding: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 用户信息区 */
.user-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx; /* 16px 间隔 */
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.avatar-btn {
  padding: 0 !important;
  margin: 0 !important;
  width: 120rpx !important; /* 调整后的宽度 */
  height: 120rpx !important; /* 调整后的高度 */
  border-radius: 50%;
  position: relative;
  background: none;
  overflow: visible;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #D9D9D9;
}

.edit-icon {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  background: #EE8924;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #F3FAFC;
}

.edit-icon image {
  width: 20rpx;
  height: 20rpx;
}

.user-info {
  margin-left: 40rpx;
  display: flex;
  flex-direction: column;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.edit-nickname-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  opacity: 0.6;
}

.edit-nickname-icon image {
  width: 100%;
  height: 100%;
}

.user-id {
  font-size: 24rpx;
  color: #666666;
  margin-top: 10rpx;
}

/* 通用版块样式 */
.section {
  margin-bottom: 50rpx;
  padding: 0 32rpx; /* 严格 16px 间隔 */
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.count {
  font-size: 28rpx;
  color: #333333;
}

/* 卡牌网格 */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.card-wrapper {
  width: 210rpx;
}

.card-item {
  width: 100%;
  height: 280rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(166, 171, 189, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.card-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.card-name {
  font-size: 24rpx;
  color: #333333;
  margin-top: 20rpx;
}

/* 成就网格 */
.achievement-grid {
  display: flex;
  gap: 20rpx;
}

.achievement-item {
  width: 210rpx;
}

.medal-box {
  width: 100%;
  height: 200rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 4rpx 4rpx 30rpx rgba(166, 171, 189, 0.4);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.medal-icon {
  width: 110rpx;
  height: 110rpx;
}

.medal-name {
  font-size: 24rpx;
  color: #333333;
  margin-top: 12rpx;
}

/* 其他工具样式 */
.group-label {
  font-size: 28rpx;
  color: #9098A3;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.tool-list {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 30rpx;
  box-shadow: 0 0 30rpx rgba(14, 39, 105, 0.05);
}

.tool-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  background: none;
  border: none;
  line-height: normal;
  text-align: left;
}

.feedback-btn {
  width: 100% !important;
  margin: 0;
}

.tool-left {
  display: flex;
  align-items: center;
}

.icon-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #A5BCFF;
  margin-right: 20rpx;
}

.tool-info {
  display: flex;
  flex-direction: column;
}

.tool-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.tool-desc {
  font-size: 24rpx;
  color: #9098A3;
  margin-top: 8rpx;
}

.arrow-right {
  width: 12rpx;
  height: 24rpx;
}

.divider {
  height: 1rpx;
  background: #EEEEEE;
}

.empty-holder {
  width: 100%;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(166, 171, 189, 0.1);
}

.empty-holder text {
  font-size: 24rpx;
  color: #999999;
}
