.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.camera,
.overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
}

.top-bar {
  position: absolute;
  top: 26rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  color: #fff;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.class-panel {
  position: absolute;
  top: 140rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 20rpx;
  padding: 20rpx;
  color: #fff;
}

.picker-btn {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

.counter {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.bottom-actions {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 170rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  text-align: center;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #fff;
}

.btn.primary {
  background: #ff7a23;
}

.btn.secondary {
  background: #2f8cff;
}

.btn.ghost {
  background: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.tips {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 120rpx;
  z-index: 20;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  text-align: center;
}

.preview-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 20;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 16rpx;
  padding: 16rpx;
  color: #fff;
}

.preview-title {
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.preview-img {
  width: 100%;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
}

.preview-path {
  margin-top: 8rpx;
  font-size: 18rpx;
  opacity: 0.85;
  word-break: break-all;
}
