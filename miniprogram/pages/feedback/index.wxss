.container {
  padding: 40rpx 32rpx; /* 16px 左右边距 */
  background-color: #F3FAFC;
  min-height: 100vh;
  box-sizing: border-box;
}

.feedback-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(166, 171, 189, 0.1);
  margin-bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.feedback-input {
  width: 100%;
  height: 300rpx;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 40rpx;
}

.submit-btn {
  background: #000000;
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.contact-info {
  text-align: center;
  padding: 0 40rpx;
  margin-top: 60rpx; /* 增加与上方按钮的间距 */
}

.contact-info text {
  font-size: 24rpx;
  color: #9098A3;
  line-height: 1.6;
}