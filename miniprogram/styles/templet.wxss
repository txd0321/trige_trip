/* 重置页面样式 */
page {
  background-color: #f8f8f8;
  height: 100%;
}

.container {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 用户信息区域 */
.userinfo {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
}

/* 登录区域 */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
.userinfo-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 32rpx;
  border: 4rpx solid #f0f0f0;
}
.userinfo-nickname {
  font-size: 36rpx;
  color: #333;
  margin-bottom: 60rpx;
  font-weight: 500;
}
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #28a745, #20c997);
}
.login-btn[loading] {
  opacity: 0.7;
}
.login-tip {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

/* 完善资料区域 */
.profile-section {
  width: 100%;
  border-top: 2rpx dashed #eee;
  padding-top: 60rpx;
  margin-top: 60rpx;
}
.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 40rpx;
  display: block;
  text-align: center;
}
.profile-form {
  width: 100%;
}
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 20rpx 0;
}
.item-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #555;
}
.avatar-btn {
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border: 2rpx solid #07c160;
  color: #07c160;
  background: none;
  border-radius: 32rpx;
}
.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-left: 30rpx;
  border: 2rpx solid #07c160;
}
.nickname-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}
.form-tip {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 40rpx;
  display: block;
}

/* 欢迎区域（已登录状态） */
.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
.welcome-text {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  margin: 40rpx 0 20rpx;
}
.sub-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 60rpx;
}
.start-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  background: linear-gradient(135deg, #007bff, #0056b3);
  color: white;
}

/* 其他区域 */
.usermotto {
  margin-top: 200rpx;
  text-align: center;
}
.user-motto {
  color: #aaa;
  font-size: 28rpx;
}
