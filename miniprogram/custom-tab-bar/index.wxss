.tab-bar {
  position: fixed;
  bottom: 40rpx; /* 调回 40rpx */
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none;
  z-index: 999;
}

.tab-bar-item {
  flex: none;
  pointer-events: auto;
  margin: 0 40rpx;
}

.circle-btn {
  width: 100rpx;
  height: 100rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}

.circle-btn.active {
  background: #333333;
  transform: scale(1.1);
}

.icon {
  width: 50rpx;
  height: 50rpx;
}

.circle-btn.active .icon {
  filter: invert(100%) brightness(200%);
}
